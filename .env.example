# Copy to .env and fill in.
#
# systemd loads this via EnvironmentFile= in deploy/music_manager.service, and
# manage.py / wsgi.py load it via python-dotenv as a fallback. Do not quote
# values — systemd takes the whole line after '=', and spaces are fine (the
# default library path contains one).

# --- REQUIRED -------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Where organized music lives:  LIBRARY_ROOT/<Album Artist>/<Album>/<NN> - <Title>.mp3
LIBRARY_ROOT=/media/pi/500gb hdd/Music

# --- Web ------------------------------------------------------------------

DJANGO_DEBUG=0
# Pin this to the Pi's hostname/IP. "*" works but accepts any Host header.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,music.local
# Needed only if you reach the dashboard over https or a non-default port.
DJANGO_CSRF_TRUSTED_ORIGINS=

TIME_ZONE=UTC
LOG_LEVEL=INFO
PAGE_SIZE=50

# --- Library scanning -----------------------------------------------------

# Directories scanned for existing audio. Separate with ':' (or ',').
# These may overlap LIBRARY_ROOT; files already in place are detected and skipped.
SCAN_ROOTS=/media/pi/500gb hdd/Music:/media/pi/500gb hdd/Youtube_Music

# Fresh downloads land here before being identified and organized.
DOWNLOAD_STAGING=/media/pi/500gb hdd/Youtube_Music/_staging

# report-only (default, changes nothing) | keep-best | keep-both
DUPLICATE_POLICY=report-only

# Off by default: the app plans moves and waits for you to review and apply
# them from the dashboard. Turn on only once you trust the plans.
AUTO_ORGANIZE=0

# --- YouTube --------------------------------------------------------------

PLAYLIST_URL=
YTDLP_PATH=/home/pi/Desktop/py_music_manager/.venv/bin/yt-dlp
PIP_PATH=/home/pi/Desktop/py_music_manager/.venv/bin/pip
# Leave blank to use ffmpeg from PATH.
FFMPEG_LOCATION=
AUDIO_QUALITY=192

# --- Identification -------------------------------------------------------

# Cheapest first. Drop any provider you do not want.
IDENTIFY_CHAIN=tags,acoustid,shazam,gemini
IDENTIFY_MIN_CONFIDENCE=0.5
PROVIDER_TIMEOUT_SECONDS=30

# AcoustID does the bulk work: it is free, and it returns track/disc numbers
# from MusicBrainz, which Plex needs and Shazam does not provide.
# Free key: https://acoustid.org/new-application
# Needs the fpcalc binary:  sudo apt install libchromaprint-tools
ACOUSTID_API_KEY=
FPCALC_PATH=fpcalc
ACOUSTID_RATE_PER_SEC=3

SHAZAM_ENABLED=1
SHAZAM_RATE_PER_MIN=20

# Last resort in the chain, capped by a hard daily budget as well as a rate
# limit. The defaults sit just under the flash-lite free-tier ceilings so the
# app throttles itself before Google does.
GEMINI_API_KEY=
# Pinned rather than a "-latest" alias: Google hot-swaps those, and the
# free-tier quota differs 25x between tiers (flash-lite 15 RPM / 500 per day,
# flash 5 RPM / 20 per day). Check current IDs at ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RATE_PER_MIN=12
GEMINI_DAILY_BUDGET=400

# --- Workers --------------------------------------------------------------

# One ffmpeg transcode already saturates a Pi 2 core. 1 keeps the UI snappy; 2
# is the practical ceiling.
WORKER_THREADS=1

# NOT a poll interval — workers block on an in-process event and wake instantly
# when work is enqueued. This only catches work enqueued by another process.
WORKER_IDLE_WAKE_SECONDS=300

# How long a claimed job stays claimed before the reaper may reclaim it.
JOB_LEASE_SECONDS=900
WORKER_COOLDOWN_SECONDS=5
JOB_RETENTION_DAYS=14

# 0 disables. Both are off by default: run a scan or sync from the dashboard
# until you are happy with the results.
SYNC_INTERVAL_MINUTES=0
RESCAN_INTERVAL_MINUTES=0

# Upgrade yt-dlp on a timer. 0 = only the dashboard button; 168 = weekly.
#
# yt-dlp is the ONLY dependency the app updates itself, because it is the only
# one that rots on someone else's schedule: YouTube changes and downloads stop,
# and the fix is always this upgrade. Everything else is pinned in
# requirements.txt and moves when you decide it should.
#
# It is safe to leave on: the job skips the restart entirely when there was
# nothing new to install, and defers while a download or a move is in flight
# rather than interrupting one.
YTDLP_AUTO_UPDATE_HOURS=0

# --- SSE ------------------------------------------------------------------

# Also not a poll interval: streams wait on a condition variable and cost
# nothing while idle. This is just how often a keepalive is emitted.
SSE_KEEPALIVE_SECONDS=25
# Streams close themselves after this so gunicorn threads always recycle.
SSE_MAX_STREAM_SECONDS=600

# --- Service --------------------------------------------------------------

SYSTEMD_SERVICE=music_manager
