# Collected static output (regenerated by `manage.py collectstatic`)
staticfiles/

# Runtime logs (server + workers)
django.log
worker.log

# Single-process guard held by the running service
.music_manager.lock

# Downloads waiting to be identified and organized
staging/
# Local test sandbox. Mirrors the Pi's layout so the dev setup and the real one
# differ only in paths:
#
#   _devdata/music/          <- /media/pi/MUSIC/Music          (scan root)
#   _devdata/youtube_music/  <- /media/pi/MUSIC/Youtube_Music  (scan root)
#   _devdata/library/        <- LIBRARY_ROOT, where organized files land
#   _devdata/staging/        <- DOWNLOAD_STAGING, pre-identification downloads
#   _devdata/db/             <- SQLite for the container
#
# Contents are ignored; scripts/devdata.py recreates the structure and sample
# files on demand, so nothing here needs to be in version control.
_devdata/
